theory VfsInplaceLifecycle
begin

// Goal-ranking tactic for the temporal key-state lemmas: their arguments
// live entirely on the key timeline, but several premise rules also carry
// file-state claims whose latest-event restriction fans out over all
// seven FileState-emitting rules. Deprioritizing those goals lets the
// key-side contradiction close first (measured: export_plain_key_live
// 12 steps with the tactic vs non-termination without).
tactic: deprioFiles
deprio:
    regex "FileState|FileVer"

tactic: prioGoalKey
prio:
    regex "GlobalKey.*~k\)"
deprio:
    regex "FileState|FileVer"
    regex "GlobalKey.*~k\."


/*
 * Symbolic lifecycle model for the PRF-keyed VFS in-place conversion wrapper.
 *
 * This is deliberately separate from vfs.spthy:
 *   - vfs.spthy models per-slot AEAD under the worker-wide global key.
 *   - this file models the operational wrapper around that primitive:
 *     global-key state, source-shape preconditions, in-place replacement,
 *     rollback, and the pool-level key purge after encrypted -> plain.
 *
 * Implementation references:
 *   src/Crypto/SqliteWasmBlazor.Crypto/Services/EncryptedSqliteWasmDatabaseService.cs
 *   src/Base/SqliteWasmBlazor/TypeScript/worker/sqlite-worker.ts
 *   src/Crypto/SqliteWasmBlazor.Crypto/TypeScript/worker/vfs-prf/key-registry.ts
 *   src/Crypto/SqliteWasmBlazor.Crypto/TypeScript/worker/vfs-prf/rekey.ts
 *
 * Concrete contract modeled:
 *   - ENCRYPT / encryptDb require a plain source and no worker globalKey.
 *     The implementation enforces this with !hasGlobalKey plus source length
 *     and the 16-byte "SQLite format 3\0" magic header.
 *   - PLAIN / REKEY / decryptDb require an encrypted source and a worker
 *     globalKey.
 *   - decryptDb does NOT clear globalKey in the single-key model. It converts
 *     one file to plain while the session key remains available so
 *     LeaveEncryptedAsync can decrypt the rest of the pool. The pool-level
 *     leave/lock step clears globalKey after the batch transition.
 *   - in-place replacement is temp-write + backup + promote. On failure after
 *     the original has moved aside, the original is restored.
 *
 * State encoding (2026-06-12 rework):
 *   Mutable state is encoded declaratively as EVENT + CLAIM + RESTRICTION
 *   instead of pass-through linear facts. Rules that change state emit a
 *   state EVENT (KeyState / FileState); rules that require state emit a
 *   CLAIM (ClaimKeyState / ClaimFileState); a "latest event before the
 *   claim must match" restriction enforces the machine. Rationale: the
 *   token-passing encoding sent Tamarin's precomputation into divergence
 *   for ANY trace-constructing (exists-trace) lemma — including on the
 *   original rule set — so its universal lemmas were never exercised
 *   against a constructed trace. With this encoding every lemma below,
 *   sanity lemmas included, verifies in seconds.
 *
 *   What the restrictions assume vs. what lemmas derive: the restrictions
 *   encode only the state-machine SEMANTICS ("the key slot holds what the
 *   last install/clear left there") — the single-slot worker key registry
 *   (key-registry.ts: one module-level field) and the C# lifecycle's
 *   sequencing discipline. The security conclusions (precondition pins,
 *   rollback/poststate guarantees, temporal key-state lemmas) remain
 *   derived theorems.
 *
 * Out of scope:
 *   - AEAD authenticity/secrecy of slots; see vfs.spthy.
 *   - Browser same-origin script attackers and memory disclosure.
 *   - Crash/power-loss between OPFS metadata operations. This model covers
 *     the synchronous error/exception paths the worker can roll back from.
 *   - Iteration over every DB in the pool; one file represents an arbitrary
 *     member of the pool batch.
 */

// ---------------------------------------------------------------------------
// State events, claims, and binders.
//
// KeyState($Device, status, key): status is 'empty' (key = 'none') or 'held'
// (key = the installed VFS key). Emitted by InitDevice, UnlockGlobalKey, and
// both Clear rules. ClaimKeyState is the read side.
//
// FileState($Device, $Path, shape, blob): shape is 'plain', 'encrypted', or
// 'busy' (original moved aside, temp being written — between Begin and
// Commit/Rollback no other operation may touch the file). ClaimFileState is
// the read side.
//
// !KeyBind / !FileVer are persistent VARIABLE BINDERS only: they let a rule
// mention the key/blob terms. Currency/validity is enforced exclusively by
// the latest-event restrictions — a stale binder picked syntactically is
// killed by the restriction, never by fact consumption.
//
// PendingEncryptOp / PendingDecryptOp are the only linear facts: created by
// Begin, consumed exactly once by Commit or Rollback. They fuse the
// backup + temp + pending bookkeeping of the implementation's
// temp-write/backup/promote sequence into one fact.
// ---------------------------------------------------------------------------

restriction key_state_claims_match_latest:
    "All Device status key #t.
        ClaimKeyState(Device, status, key) @ #t
        ==> Ex #u.
              KeyState(Device, status, key) @ #u & #u < #t
            & not (Ex s2 k2 #v.
                     KeyState(Device, s2, k2) @ #v & #u < #v & #v < #t)"

restriction file_state_claims_match_latest:
    "All Device path shape blob #t.
        ClaimFileState(Device, path, shape, blob) @ #t
        ==> Ex #u.
              FileState(Device, path, shape, blob) @ #u & #u < #t
            & not (Ex sh2 b2 #v.
                     FileState(Device, path, sh2, b2) @ #v & #u < #v & #v < #t)"

// ---------------------------------------------------------------------------
// Initial device/file states.
//
// The worker holds exactly ONE globalKey slot (key-registry.ts is a single
// module-level field): one key-state timeline per device, rooted at the
// unique InitDevice event.
// ---------------------------------------------------------------------------

rule InitDevice:
    [ ]
  --[ DeviceInitialized($Device)
    , KeyState($Device, 'empty', 'none')
    ]->
    [ ]

restriction device_initialized_once:
    "All Device #i #j.
        DeviceInitialized(Device) @ #i & DeviceInitialized(Device) @ #j
        ==> #i = #j"

rule InitPlainFile:
    [ Fr(~plain_blob) ]
  --[ FileInitialized($Device, $Path, 'plain', ~plain_blob)
    , FileState($Device, $Path, 'plain', ~plain_blob)
    ]->
    [ !FileVer($Device, $Path, 'plain', ~plain_blob) ]

rule InitEncryptedFileLocked:
    [ Fr(~cipher_blob) ]
  --[ FileInitialized($Device, $Path, 'encrypted', ~cipher_blob)
    , FileState($Device, $Path, 'encrypted', ~cipher_blob)
    ]->
    [ !FileVer($Device, $Path, 'encrypted', ~cipher_blob) ]

rule UnlockGlobalKey:
    [ Fr(~k) ]
  --[ ClaimKeyState($Device, 'empty', 'none')
    , GlobalKeyInstalled($Device, ~k)
    , SourceGlobalState($Device, 'globalEmpty')
    , GlobalPostState($Device, 'registered')
    , KeyState($Device, 'held', ~k)
    ]->
    [ !KeyBind($Device, ~k) ]

rule ClearGlobalKeyForLock:
    [ !KeyBind($Device, k) ]
  --[ ClaimKeyState($Device, 'held', k)
    , GlobalKeyCleared($Device, k)
    , PoolPostState($Device, 'encrypted', 'globalEmpty')
    , KeyState($Device, 'empty', 'none')
    ]->
    [ ]

rule ClearGlobalKeyForLeaveEncrypted:
    [ !KeyBind($Device, k) ]
  --[ ClaimKeyState($Device, 'held', k)
    , LeaveEncryptedAccepted($Device, k)
    , GlobalKeyCleared($Device, k)
    , PoolPostState($Device, 'plain', 'globalEmpty')
    , KeyState($Device, 'empty', 'none')
    ]->
    [ ]

// ---------------------------------------------------------------------------
// Export wrapper preconditions. Exports read state and change nothing —
// claims only, no state events.
// ---------------------------------------------------------------------------

rule ExportEncryptPlainSource:
    [ !FileVer($Device, $Path, 'plain', plain_blob)
    , Fr(~target_key)
    , Fr(~cipher_blob)
    ]
  --[ ClaimFileState($Device, $Path, 'plain', plain_blob)
    , ClaimKeyState($Device, 'empty', 'none')
    , ExportEncryptAccepted($Device, $Path, plain_blob, ~cipher_blob, ~target_key)
    , SourceState($Device, $Path, 'plain', 'globalEmpty')
    , PlainMagicChecked($Device, $Path, plain_blob)
    , PostState($Device, $Path, 'plain', 'globalEmpty')
    ]->
    [ ]

rule ExportPlainEncryptedSource:
    [ !FileVer($Device, $Path, 'encrypted', cipher_blob)
    , !KeyBind($Device, k_old)
    , Fr(~plain_blob)
    ]
  --[ ClaimFileState($Device, $Path, 'encrypted', cipher_blob)
    , ClaimKeyState($Device, 'held', k_old)
    , ExportPlainAccepted($Device, $Path, cipher_blob, ~plain_blob, k_old)
    , SourceState($Device, $Path, 'encrypted', 'globalKey')
    , PostState($Device, $Path, 'encrypted', 'globalKey')
    ]->
    [ ]

rule ExportRekeyEncryptedSource:
    [ !FileVer($Device, $Path, 'encrypted', cipher_blob)
    , !KeyBind($Device, k_old)
    , Fr(~target_key)
    , Fr(~new_cipher_blob)
    ]
  --[ ClaimFileState($Device, $Path, 'encrypted', cipher_blob)
    , ClaimKeyState($Device, 'held', k_old)
    , ExportRekeyAccepted($Device, $Path, cipher_blob, ~new_cipher_blob, k_old, ~target_key)
    , SourceState($Device, $Path, 'encrypted', 'globalKey')
    , PostState($Device, $Path, 'encrypted', 'globalKey')
    ]->
    [ ]

// ---------------------------------------------------------------------------
// Encrypt in place: plain -> encrypted.
// ---------------------------------------------------------------------------

rule BeginEncryptInPlace:
    [ !FileVer($Device, $Path, 'plain', plain_blob)
    , Fr(~target_key)
    , Fr(~cipher_blob)
    ]
  --[ ClaimFileState($Device, $Path, 'plain', plain_blob)
    , ClaimKeyState($Device, 'empty', 'none')
    , EncryptInPlaceStarted($Device, $Path, plain_blob, ~cipher_blob, ~target_key)
    , SourceState($Device, $Path, 'plain', 'globalEmpty')
    , PlainMagicChecked($Device, $Path, plain_blob)
    , FileState($Device, $Path, 'busy', plain_blob)
    ]->
    [ PendingEncryptOp($Device, $Path, plain_blob, ~cipher_blob, ~target_key) ]

rule CommitEncryptInPlace:
    [ PendingEncryptOp(D, P, plain_blob, cipher_blob, target_key) ]
  --[ ClaimKeyState(D, 'empty', 'none')
    , ReplaceCommitted(D, P, 'plain', 'encrypted')
    , EncryptInPlaceAccepted(D, P, plain_blob, cipher_blob, target_key)
    , SourceState(D, P, 'plain', 'globalEmpty')
    , PlainMagicChecked(D, P, plain_blob)
    , PostState(D, P, 'encrypted', 'globalEmpty')
    , FileState(D, P, 'encrypted', cipher_blob)
    ]->
    [ !FileVer(D, P, 'encrypted', cipher_blob) ]

rule RollbackEncryptInPlace:
    [ PendingEncryptOp(D, P, plain_blob, cipher_blob, target_key) ]
  --[ ClaimKeyState(D, 'empty', 'none')
    , ReplaceFailed(D, P, 'plain', 'encrypted', plain_blob)
    , OriginalRestored(D, P, 'plain', plain_blob)
    , EncryptInPlaceFailed(D, P, plain_blob, cipher_blob, target_key)
    , PostState(D, P, 'plain', 'globalEmpty')
    , FileState(D, P, 'plain', plain_blob)
    ]->
    [ ]

// ---------------------------------------------------------------------------
// Decrypt in place: encrypted -> plain.
// ---------------------------------------------------------------------------

rule BeginDecryptInPlace:
    [ !FileVer($Device, $Path, 'encrypted', cipher_blob)
    , !KeyBind($Device, k_old)
    , Fr(~plain_blob)
    ]
  --[ ClaimFileState($Device, $Path, 'encrypted', cipher_blob)
    , ClaimKeyState($Device, 'held', k_old)
    , DecryptInPlaceStarted($Device, $Path, cipher_blob, ~plain_blob, k_old)
    , SourceState($Device, $Path, 'encrypted', 'globalKey')
    , FileState($Device, $Path, 'busy', cipher_blob)
    ]->
    [ PendingDecryptOp($Device, $Path, cipher_blob, ~plain_blob, k_old) ]

rule CommitDecryptInPlace:
    [ PendingDecryptOp(D, P, cipher_blob, plain_blob, k_old) ]
  --[ ClaimKeyState(D, 'held', k_old)
    , ReplaceCommitted(D, P, 'encrypted', 'plain')
    , DecryptInPlaceAccepted(D, P, cipher_blob, plain_blob, k_old)
    , SourceState(D, P, 'encrypted', 'globalKey')
    , PostState(D, P, 'plain', 'globalKey')
    , FileState(D, P, 'plain', plain_blob)
    ]->
    [ !FileVer(D, P, 'plain', plain_blob) ]

rule RollbackDecryptInPlace:
    [ PendingDecryptOp(D, P, cipher_blob, plain_blob, k_old) ]
  --[ ClaimKeyState(D, 'held', k_old)
    , ReplaceFailed(D, P, 'encrypted', 'plain', cipher_blob)
    , OriginalRestored(D, P, 'encrypted', cipher_blob)
    , DecryptInPlaceFailed(D, P, cipher_blob, plain_blob, k_old)
    , PostState(D, P, 'encrypted', 'globalKey')
    , FileState(D, P, 'encrypted', cipher_blob)
    ]->
    [ ]

// ---------------------------------------------------------------------------
// Lemmas.
// ---------------------------------------------------------------------------

lemma key_install_requires_empty_global_key:
    "All Device k #t.
        GlobalKeyInstalled(Device, k) @ #t
        ==> SourceGlobalState(Device, 'globalEmpty') @ #t"

lemma export_encrypt_requires_plain_without_global_key:
    "All Device path plain_blob cipher_blob target_key #t.
        ExportEncryptAccepted(Device, path, plain_blob, cipher_blob, target_key) @ #t
        ==> SourceState(Device, path, 'plain', 'globalEmpty') @ #t
          & PlainMagicChecked(Device, path, plain_blob) @ #t"

lemma encrypt_in_place_requires_plain_without_global_key:
    "All Device path plain_blob cipher_blob target_key #t.
        EncryptInPlaceAccepted(Device, path, plain_blob, cipher_blob, target_key) @ #t
        ==> SourceState(Device, path, 'plain', 'globalEmpty') @ #t
          & PlainMagicChecked(Device, path, plain_blob) @ #t"

lemma export_plain_requires_encrypted_global_key:
    "All Device path cipher_blob plain_blob k_old #t.
        ExportPlainAccepted(Device, path, cipher_blob, plain_blob, k_old) @ #t
        ==> SourceState(Device, path, 'encrypted', 'globalKey') @ #t"

lemma export_rekey_requires_encrypted_global_key:
    "All Device path cipher_blob new_cipher_blob k_old target_key #t.
        ExportRekeyAccepted(Device, path, cipher_blob, new_cipher_blob, k_old, target_key) @ #t
        ==> SourceState(Device, path, 'encrypted', 'globalKey') @ #t"

lemma decrypt_in_place_requires_encrypted_global_key:
    "All Device path cipher_blob plain_blob k_old #t.
        DecryptInPlaceAccepted(Device, path, cipher_blob, plain_blob, k_old) @ #t
        ==> SourceState(Device, path, 'encrypted', 'globalKey') @ #t"

lemma decrypt_success_keeps_global_key_until_pool_leave:
    "All Device path cipher_blob plain_blob k_old #t.
        DecryptInPlaceAccepted(Device, path, cipher_blob, plain_blob, k_old) @ #t
        ==> PostState(Device, path, 'plain', 'globalKey') @ #t"

lemma decrypt_failure_keeps_global_key:
    "All Device path cipher_blob plain_blob k_old #t.
        DecryptInPlaceFailed(Device, path, cipher_blob, plain_blob, k_old) @ #t
        ==> PostState(Device, path, 'encrypted', 'globalKey') @ #t"

lemma leave_encrypted_clears_global_key:
    "All Device k #t.
        LeaveEncryptedAccepted(Device, k) @ #t
        ==> GlobalKeyCleared(Device, k) @ #t
          & PoolPostState(Device, 'plain', 'globalEmpty') @ #t"

lemma replacement_failure_restores_original:
    "All Device path from_shape to_shape original_blob #t.
        ReplaceFailed(Device, path, from_shape, to_shape, original_blob) @ #t
        ==> OriginalRestored(Device, path, from_shape, original_blob) @ #t"

lemma encrypt_failure_restores_plain_original:
    "All Device path plain_blob cipher_blob target_key #t.
        EncryptInPlaceFailed(Device, path, plain_blob, cipher_blob, target_key) @ #t
        ==> OriginalRestored(Device, path, 'plain', plain_blob) @ #t
          & PostState(Device, path, 'plain', 'globalEmpty') @ #t"

lemma decrypt_failure_restores_encrypted_original:
    "All Device path cipher_blob plain_blob k_old #t.
        DecryptInPlaceFailed(Device, path, cipher_blob, plain_blob, k_old) @ #t
        ==> OriginalRestored(Device, path, 'encrypted', cipher_blob) @ #t
          & PostState(Device, path, 'encrypted', 'globalKey') @ #t"

lemma encrypt_success_poststate:
    "All Device path plain_blob cipher_blob target_key #t.
        EncryptInPlaceAccepted(Device, path, plain_blob, cipher_blob, target_key) @ #t
        ==> ReplaceCommitted(Device, path, 'plain', 'encrypted') @ #t
          & PostState(Device, path, 'encrypted', 'globalEmpty') @ #t"

lemma decrypt_success_poststate:
    "All Device path cipher_blob plain_blob k_old #t.
        DecryptInPlaceAccepted(Device, path, cipher_blob, plain_blob, k_old) @ #t
        ==> ReplaceCommitted(Device, path, 'encrypted', 'plain') @ #t
          & PostState(Device, path, 'plain', 'globalKey') @ #t"

/*
 * Reachability sanity lemmas (exists-trace) — the universal lemmas above
 * would verify vacuously over unreachable events. Placed BEFORE the
 * [reuse] invariants deliberately: reuse lemmas inject into every proof
 * after them in file order, and the injected induction machinery makes
 * the exists-trace constructions diverge.
 */
lemma sanity_encrypt_commit_reachable:
    exists-trace
    "Ex D p pb cb tk #t. EncryptInPlaceAccepted(D, p, pb, cb, tk) @ #t"

lemma sanity_encrypt_rollback_reachable:
    exists-trace
    "Ex D p pb cb tk #t. EncryptInPlaceFailed(D, p, pb, cb, tk) @ #t"

lemma sanity_decrypt_commit_reachable:
    exists-trace
    "Ex D p cb pb k #t. DecryptInPlaceAccepted(D, p, cb, pb, k) @ #t"

lemma sanity_decrypt_rollback_reachable:
    exists-trace
    "Ex D p cb pb k #t. DecryptInPlaceFailed(D, p, cb, pb, k) @ #t"

lemma sanity_export_encrypt_reachable:
    exists-trace
    "Ex D p pb cb tk #t. ExportEncryptAccepted(D, p, pb, cb, tk) @ #t"

lemma sanity_export_plain_reachable:
    exists-trace
    "Ex D p cb pb k #t. ExportPlainAccepted(D, p, cb, pb, k) @ #t"

lemma sanity_export_rekey_reachable:
    exists-trace
    "Ex D p cb ncb k tk #t. ExportRekeyAccepted(D, p, cb, ncb, k, tk) @ #t"

lemma sanity_leave_encrypted_reachable:
    exists-trace
    "Ex D k #t. LeaveEncryptedAccepted(D, k) @ #t"


// By-construction case split: an empty-slot event is the device init or
// coincides with a clear (inspection of the three emitting rules).
lemma empty_event_is_init_or_clear:
    "All Device #c.
        KeyState(Device, 'empty', 'none') @ #c
        ==> DeviceInitialized(Device) @ #c
          | (Ex k. GlobalKeyCleared(Device, k) @ #c)"

// Each key is installed at most once (Fr at UnlockGlobalKey).
lemma key_installed_once [reuse]:
    "All Device k #i #j.
        GlobalKeyInstalled(Device, k) @ #i & GlobalKeyInstalled(Device, k) @ #j
        ==> #i = #j"

/*
 * Temporal key-state lemmas — the machine-verified set.
 *
 * These derive cross-trace orderings from the latest-event semantics, so
 * they would catch a rule that *labels* the right source state while its
 * claims no longer enforce it. Proven shapes (2026-06-13, per-lemma):
 *
 *   - export_plain_key_live_since_install: ORIGINAL strength.
 *   - decrypt: split — the installed-before-use half is verified here;
 *     the no-clear-before-use half is pending (see below).
 *   - encrypt / export_encrypt: verified in keyslot-emptied form — the
 *     slot was EMPTIED strictly between any earlier install and the
 *     plain-source op. Combined with empty_event_is_init_or_clear and
 *     init-uniqueness (the emptying event cannot be the init, which
 *     precedes the install), this yields "some key was cleared in the
 *     window" by a one-step manual argument; the per-key strong form
 *     (THE installed key was cleared) additionally needs the inductive
 *     descent that remains open in the pending lemmas.
 */

lemma clear_requires_install [reuse]:
    "All Device k #c.
        GlobalKeyCleared(Device, k) @ #c
        ==> Ex #i. GlobalKeyInstalled(Device, k) @ #i & #i < #c"

lemma cleared_key_never_held_again [reuse]:
    "All Device k #c #u.
        GlobalKeyCleared(Device, k) @ #c
      & KeyState(Device, 'held', k) @ #u
        ==> #u < #c"

// No operation that needs the global key can run after that key was cleared:
// the use-after-clear property, and the far end of the key's life from
// decrypt_key_installed_before_use.
//
// Stated over ClaimKeyState rather than over one accepting rule, for two
// reasons. It is stronger — it covers all seven rules that claim a held key
// (both Clear rules, ExportPlain, ExportRekey, and Begin/Commit/Rollback
// DecryptInPlace) where a per-rule form covers one. And it carries no file
// variables, so the proof cannot descend PendingDecryptOp ->
// BeginDecryptInPlace -> the file-state claim; a decrypt-only phrasing does
// carry them, and diverges (measured: >10 min under deprioFiles, under a
// tactic that also deprioritises the pending ops, and with the key-side
// lemmas below available as reuse). This form closes in 12 steps.
lemma no_claim_held_after_clear [reuse]:
    "All Device k #c #t.
        GlobalKeyCleared(Device, k) @ #c
      & ClaimKeyState(Device, 'held', k) @ #t
      & #c < #t
        ==> F"

lemma decrypt_key_installed_before_use:
    "All Device path cipher_blob plain_blob k_old #t.
        DecryptInPlaceAccepted(Device, path, cipher_blob, plain_blob, k_old) @ #t
        ==> Ex #t1. GlobalKeyInstalled(Device, k_old) @ #t1 & #t1 < #t"

lemma export_plain_key_live_since_install [heuristic={deprioFiles}]:
    "All Device path cipher_blob plain_blob k_old #t.
        ExportPlainAccepted(Device, path, cipher_blob, plain_blob, k_old) @ #t
        ==> (Ex #t1. GlobalKeyInstalled(Device, k_old) @ #t1 & #t1 < #t)
          & not (Ex #t2. GlobalKeyCleared(Device, k_old) @ #t2 & #t2 < #t)"



lemma encrypt_in_place_no_live_key:
    "All Device path plain_blob cipher_blob target_key k #i #t.
        EncryptInPlaceAccepted(Device, path, plain_blob, cipher_blob, target_key) @ #t
      & GlobalKeyInstalled(Device, k) @ #i & #i < #t
        ==> Ex #c. KeyState(Device, 'empty', 'none') @ #c & #i < #c & #c < #t"

lemma export_encrypt_no_live_key [heuristic={deprioFiles}]:
    "All Device path plain_blob cipher_blob target_key k #i #t.
        ExportEncryptAccepted(Device, path, plain_blob, cipher_blob, target_key) @ #t
      & GlobalKeyInstalled(Device, k) @ #i & #i < #t
        ==> Ex #c. KeyState(Device, 'empty', 'none') @ #c & #i < #c & #c < #t"




// Every key-state event is rooted at the device's unique init. Kept LAST
// among the proven lemmas: it is [reuse], and reuse-axiom injection makes
// the proofs above diverge (measured) — placement is load-bearing.
lemma key_event_rooted_at_init [use_induction, reuse]:
    "All Device s k #c.
        KeyState(Device, s, k) @ #c
        ==> Ex #r. DeviceInitialized(Device) @ #r & ( #r < #c | #r = #c )"

end
