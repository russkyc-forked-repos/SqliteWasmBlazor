@*
    Import-target dialog for a picked .db file. A file's name and a
    database's name are different things: an export is stamped
    (TodoDb-20260818-193737.db) while the database it came from is not, so
    inheriting the file name would leave a stray in the pool instead of
    restoring the original. The field is prefilled with the stamp removed
    and the databases already stored are listed, so an overwrite is visible
    before it happens.

    Action layout follows DestructiveConfirmDialog: cancel is the primary
    default, the consequential action is red and outlined, and the pair
    stacks at SmAndDown (cancel underneath, full width) before becoming a row
    on md and up. Focus starts in the name field — the user is here to decide
    a name, not to click through.
*@

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1" Class="mb-3">@Message</MudText>
        <MudTextField T="string"
                      @bind-Value="_name"
                      Label="@Label"
                      HelperText="@HelperText"
                      Immediate="true"
                      autofocus />
        @if (!string.IsNullOrEmpty(ExistingSummary))
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2 d-block">
                @ExistingSummary
            </MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudStack Row="true"
                  Breakpoint="Breakpoint.SmAndDown"
                  Justify="Justify.FlexEnd"
                  Spacing="2"
                  Class="mud-width-full">
            <MudButton OnClick="OnConfirm"
                       Disabled="@string.IsNullOrWhiteSpace(_name)"
                       Variant="Variant.Outlined"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Warning">
                @ConfirmLabel
            </MudButton>
            <MudButton OnClick="OnCancel"
                       Variant="Variant.Filled"
                       Color="Color.Primary">
                @CancelLabel
            </MudButton>
        </MudStack>
    </DialogActions>
</MudDialog>

@code {
    private string _name = string.Empty;

    [CascadingParameter]
    public required IMudDialogInstance MudDialog { get; set; }

    [Parameter, EditorRequired]
    public required string Message { get; set; }

    [Parameter, EditorRequired]
    public required string Label { get; set; }

    [Parameter, EditorRequired]
    public required string HelperText { get; set; }

    /// <summary>Proposed name; the field starts here and the user edits it.</summary>
    [Parameter, EditorRequired]
    public required string InitialName { get; set; }

    /// <summary>Pre-formatted list of names already in the pool, or null.</summary>
    [Parameter]
    public string? ExistingSummary { get; set; }

    [Parameter, EditorRequired]
    public required string ConfirmLabel { get; set; }

    [Parameter, EditorRequired]
    public required string CancelLabel { get; set; }

    protected override void OnInitialized() => _name = InitialName;

    private void OnConfirm() => MudDialog.Close(DialogResult.Ok(_name.Trim()));

    private void OnCancel() => MudDialog.Cancel();
}
